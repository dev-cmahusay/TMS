# Public (safe to expose to browser; RLS protects database)
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
PUBLIC_TURNSTILE_SITE_KEY=

# Server-only secrets (set via Cloudflare secrets in production; NEVER commit .env)
SUPABASE_SERVICE_ROLE_KEY=
TURNSTILE_SECRET_KEY=
RESEND_API_KEY=

# Server config
EMAIL_FROM=
SUPPORT_INBOX_EMAIL=
EMAIL_MODE=log
RATE_LIMIT_IP_PER_HOUR=20
RATE_LIMIT_EMAIL_PER_HOUR=5

# Monitoring
SENTRY_DSN=
